# Copy to .env next to docker-compose.yml and change every value.
POSTGRES_PASSWORD=change-me-strong-db-password
# External-database variant (docker-compose.yml) only — not needed for bundled-db:
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=logsphere
DB_USER=postgres
# Npgsql client-side pooling. Direct PostgreSQL -> true. Through PgBouncer (or any external
# pooler) -> MUST be false: cancels routed through a pooler corrupt other pooled sessions.
DB_POOLING=true
# GeoIP enrichment (optional): path to a GeoLite2-City.mmdb inside the container; empty = disabled
GEOIP_DB_PATH=
JWT_SECRET=change-me-64-char-random-string-for-jwt-signing-0123456789abcdef
KEY_PEPPER=change-me-random-pepper-for-api-key-hashing
SANITIZATION_HASH_KEY=change-me-random-key-for-hash-redaction
ADMIN_PASSWORD=change-me-initial-admin-password
DASHBOARD_ORIGIN=http://localhost:8080
SEED_DEMO_DATA=false
ASPNETCORE_ENVIRONMENT=Production
